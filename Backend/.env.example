# Copie para .env; preencha as credenciais locais. Não publique este arquivo com valores reais.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=false
# Escuta todas as interfaces da máquina, sem fixar o IP da rede local.
# Use 127.0.0.1 para limitar explicitamente o acesso a este computador.
API_HOST=0.0.0.0
PORT=5000
# Banco já preparado: python -m migrations apenas confere; --aplicar é manutenção manual.
DB_HOST=localhost
DB_PORT=3054
DB_USER=SYSDBA
DB_PASSWORD=
# Quando ausente, DB_NAME usa Backend/CORTAE.FDB.
# Quando ausente, LOG_DB_NAME usa Backend/LOG_CORTAE.FDB.
LOG_DB_HOST=localhost
LOG_DB_PORT=3054
LOG_DB_USER=SYSDBA
LOG_DB_PASSWORD=
LOG_DB_TABLE=LOG_ALTERACAO
LOG_OBRIGATORIO=false
# Runtime local exato Firebird 4.0.4.3010 x86, sem serviço Windows/admin.
# Iniciar só gerencia localhost/127.0.0.1/::1 na porta 3054; remoto/porta explícitos são respeitados.
CORTAE_FIREBIRD_AUTO_START=true
# Vazio usa %LOCALAPPDATA%\Cortae\runtimes\Firebird-4.0.4.3010-Win32.
CORTAE_FIREBIRD_HOME=
MAIL_USER=
MAIL_PASSWORD=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
# URL acessível aos destinatários dos convites e avisos de disponibilidade.
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_FRONTEND_URL=http://127.0.0.1:5173
# Processa a fila persistida de e-mails a cada 30 segundos.
WAITLIST_WORKER=true
OPENAI_API_KEY=
VISAGISMO_ANALYSIS_MODEL=gpt-5.6-terra
VISAGISMO_IMAGE_MODEL=gpt-image-2
VISAGISMO_IMAGE_QUALITY=medium
ARKHE_CLIENT_ID=
ARKHE_CLIENT_SECRET=
# Imagens são otimizadas no backend; credenciais e fotos não entram no Git.
IMAGE_STORAGE_PROVIDER=google_drive
# Em hospedagem: JSON authorized_user completo no cofre de segredos do servidor.
# Inclui refresh_token após consentimento; só Client ID/Secret não autorizam o Drive.
GOOGLE_DRIVE_CREDENTIALS_JSON=
# Alternativa legada: arquivo privado somente no servidor, fora do projeto.
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_FOLDER_IDS_FILE=
# Vazio usa Backend/google_drive_folders.json (pastas existentes da conta Cortaê).
# Para outra instalação, substitua por JSON com área e ID de pasta.
GOOGLE_DRIVE_FOLDER_IDS=
# Apenas para contas de serviço em um Drive compartilhado do Workspace.
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# WhatsApp WAHA: instalar compose.waha.yaml e parear uma vez pelo QR no servidor.
# Não habilita envio automático; configurar_whatsapp.py administra a conexão.
WAHA_ENABLED=false
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_TIMEOUT=20
# Até oito arquivos de 10 MB, mais dados do formulário; cada imagem é validada separadamente.
MAX_CONTENT_LENGTH=89128960
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_USER_AGENT=Cortae (contato-tecnico@example.com)
# Default read-only token: quotation/tracking. Enable only with authorized write scopes.
MELHOR_ENVIO_EMITIR_ETIQUETAS=false
# Publication requires the actual operator name, contact and a valid fee payer.
# Document and address are optional; keep missing values blank (never invent them).
# Changing any of these fields versions the terms and requires fresh acceptance.
TERMOS_RESPONSAVEL_NOME=
TERMOS_RESPONSAVEL_DOCUMENTO=
TERMOS_RESPONSAVEL_CONTATO=
TERMOS_RESPONSAVEL_ENDERECO=
# Fill only after the commercial policy is confirmed: cliente or barbearia.
PLATAFORMA_TAXA_PAGADOR=
