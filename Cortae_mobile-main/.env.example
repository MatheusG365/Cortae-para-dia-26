# Development discovers the computer running Expo automatically. No IP is needed.
# API port defaults to 5000; change only when the backend uses another port.
# EXPO_PUBLIC_API_PORT=5000

# Published native build: configure your public HTTPS API once before building.
# Also use this when an Expo tunnel cannot reach the local API. Never put secrets here.
# EXPO_PUBLIC_API_URL=https://api.seudominio.com

# Public website origin used when sharing the salon/professional booking link.
# EXPO_PUBLIC_WEB_URL=https://seu-site.example
